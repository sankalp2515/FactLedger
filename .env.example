# Copy to .env only if it does not exist. Never commit populated credentials.
MODE=development
DATABASE_URL=sqlite:///.data/workspace.db
ARTIFACT_DIR=.data/artifacts
SESSION_SECRET=replace-with-a-long-random-local-secret
SERPAPI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LOCAL_DB_PASSWORD=local-development-only
APP_PORT=8008
# Required before production mode is enabled; issuer discovery uses HTTPS.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_WORKSPACE_ID=
PUBLIC_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
WORKSPACE_DAILY_USD=10
WORKSPACE_STORAGE_BYTES=1073741824
MAX_RUN_SECONDS=600
# Estimates for admission/accounting; configure dated provider rates before deployment.
SERPAPI_SEARCH_USD=0.01
LLM_INPUT_USD_PER_MILLION=0.6
LLM_OUTPUT_USD_PER_MILLION=0.8
