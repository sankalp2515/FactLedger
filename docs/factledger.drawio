<mxfile host="app.diagrams.net" type="device">
<diagram id="frame0" name="01 · Product decision"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="01 · Product decision" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Focused problem: public-project claims blur announcement, funding, completion and operation." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="user" value="Newsroom researcher
Indian public-interest desk" tooltip="Primary user: English-language desk researcher checking policy, public spending and project-delivery claims. Start with public documents and news; validate with five researchers and two editors." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="task" value="Check a public claim
Project · stage · as-of period" tooltip="Atomic claim needs period, geography, units, denominator and stage. Claims of causality, predictions or private evidence require clarification/specialist work." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="pain" value="Reconstruct the evidence
Searches · quotes · context" tooltip="Desk-research hypothesis: assembling evidence and editor handoff create rework. Published practices support the workflow; interviews must establish its frequency and severity." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7e2e2;strokeColor=#984747;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="researcher" value="Researcher outcome
Reproducible evidence case" tooltip="Preserved excerpts and source versions; primary evidence, opposing evidence and missing evidence are visible. Researcher proposes a qualified conclusion." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="product" value="FactLedger
Evidence investigation workspace" tooltip="Persistent investigation cases for public spending/project-delivery claims. Stage ledger, funding comparison, exact source anchors, missing evidence, editor review and frozen packs. No ground-truth certification." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="editor" value="Editor outcome
Inspect · challenge · approve" tooltip="Editor reviews a frozen revision, traces every assertion and returns missing-evidence requests or signs off an accountable conclusion." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="receives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="user" target="task"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="requires" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="task" target="pain"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="product hypothesis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="pain" target="product"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="enables" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="product" target="researcher"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="hands off" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="product" target="editor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Decision: Knowledge &amp; Public Interest. Product value is measured by editor-accepted cases and quality, not report length." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="865" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame1" name="02 · Painful workflow"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="02 · Painful workflow" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Current workflow is sourced; prevalence and time savings need a pilot." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="intake" value="Receive claim
Tip / statement / article" tooltip="Manual intake from public text, URL or PDF. Preserve claimant attribution; private messaging access is not assumed." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="search" value="Repeated searching
Terms · domains · dates" tooltip="Current process: varied searches and source location recall. Full Fact describes preparation and shared source documents; no exact time estimate is established." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="notes" value="Manual evidence notes
Quote + URL + interpretation" tooltip="Current process: evidence assembled and handed to reviewer. Potential rework and duplicated source counting need direct user validation." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="scope" value="Confirm claim scope
Period · metric · stage" tooltip="Proposed intake clarifies exactly what will be checked; user confirmation prevents silent claim rewriting." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="gather" value="Guided investigation
Discover → fetch → compare" tooltip="SerpApi discovers sources; source retrieval anchors evidence. Follow-up queries respond to explicit missing primary evidence or disagreement." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="review" value="Persistent case review
Versioned evidence + conclusion" tooltip="Reviewer works from one revision with source reader and excerpts. Exports stay reproducible after further research." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="intake" target="search"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="editor reconstructs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="search" target="notes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="proposed flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="intake" target="scope"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="scope" target="gather"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="gather" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Pain hypotheses: ambiguous scope, source tracing, repeated reporting, stale definitions, fragmented notes and review rework." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="865" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame2" name="03 · Alternatives &amp; track"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="03 · Alternatives &amp; track" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Select by the user’s job; no evidence supports track win probabilities." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="general" value="General research reports
Broad audience" tooltip="Alternative A: easy chat experience, strong incumbents already plan, search and cite. Need demonstrable differentiation beyond a longer report." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="consumer" value="Consumer claim checker
Reader-facing browser tool" tooltip="Alternative B: low-friction public use, but distribution, multimedia access, trust and unknown claim scope complicate adoption." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="case" value="Evidence case workspace
Professional review workflow" tooltip="Selected alternative C: narrower primary user, inspectable source/context comparisons and clear editorial handoff. Requires user validation; no world-first claim." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="knowledge" value="Knowledge &amp; Public Interest
SELECTED track" tooltip="Best description of research/news literacy and public-interest users. Official track choice follows primary purpose; organizers can reclassify." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="agents" value="AI Agents
Technical approach / runner-up" tooltip="Adaptive queries, source selection and gap-driven loops remain core. Does not become a generic fixed search pipeline." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="proof" value="Adoption &amp; quality gate
Pilot + adjudicated evaluation" tooltip="Test five researchers, two editors and ten paired case tasks. Targets: repeat adoption, ≥30% lower active time and no degraded evidence quality; unachieved." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="compare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="general" target="proof"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="compare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="consumer" target="proof"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="primary purpose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="case" target="knowledge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="implemented through" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="case" target="agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="measure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="agents" target="proof"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Scope: first release is English public policy/spending/project claims. Future languages and multimedia require evaluated extensions." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="865" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame3" name="04 · System context · C4 L1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="04 · System context · C4 L1" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="People, product and external systems. Arrows name the exchanged information." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="journalist" value="Researcher
Claim and source selection" tooltip="Creates/scopes cases, inspects evidence, corrects relations and submits a revision for review. Access is workspace-scoped." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="product" value="FactLedger system
Case → evidence → review" tooltip="One product boundary owns claim cases, evidence artifacts, AI judgments, human conclusions and export history." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="390" width="260" height="100" as="geometry"/></mxCell><mxCell id="editor" value="Editor
Review and approval" tooltip="Reviewers inspect strongest opposition, source lineage and qualifications; approvals bind frozen revisions." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="search" value="SerpApi
Structured discovery" tooltip="Google Search, News and Scholar APIs supply discovery metadata. Store query parameters, result ranks, times and provider search IDs; redact keys." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="260" height="100" as="geometry"/></mxCell><mxCell id="sources" value="Public source sites
HTML / PDF evidence" tooltip="Public webpages and documents supply underlying evidence. Access failures are recorded, not bypassed; source snapshots are private artifacts." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="760" width="260" height="100" as="geometry"/></mxCell><mxCell id="model" value="Model provider
Typed draft judgments" tooltip="Receives bounded selected content for planning and relation proposals. Cannot autonomously invoke tools; exact quotes validated deterministically." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="610" width="260" height="100" as="geometry"/></mxCell><mxCell id="oidc" value="Identity issuer
Verified identity token" tooltip="Production OIDC issuer/audience/expiry validated. Local development identity cannot operate in production." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="claims / edits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="journalist" target="product"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="review / decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="editor" target="product"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="oidc" target="product"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="query ↔ results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="product" target="search"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="URL ↔ content" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="product" target="sources"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="context ↔ judgments" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="product" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="No automatic claimant outreach, external publishing or private social-platform ingestion." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="965" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame4" name="05 · Containers &amp; deployment · C4 L2"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1170"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="05 · Containers &amp; deployment · C4 L2" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Modular API + durable worker; PostgreSQL is authority. Proposed stack." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="browser" value="Web workspace
React + TypeScript" tooltip="Library/intake, evidence reader, timeline, review queue and revision diff. Only calls API; no provider credentials." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="260" height="100" as="geometry"/></mxCell><mxCell id="api" value="Application API
FastAPI · modules · SSE" tooltip="Auth/tenancy, cases/runs, optimistic revisions, source additions, review/export commands, durable progress replay." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="160" width="260" height="100" as="geometry"/></mxCell><mxCell id="identity" value="OIDC issuer
Membership + role checks" tooltip="External issuer validates identity; application membership determines workspace and editor permissions." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="260" height="100" as="geometry"/></mxCell><mxCell id="db" value="PostgreSQL
Cases · evidence · outbox" tooltip="Durable claims, immutable revisions, events, checkpoints, reviews and outbox. Full-text retrieval; optional embeddings for candidate selection." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="410" width="260" height="100" as="geometry"/></mxCell><mxCell id="queue" value="Redis / queue
Jobs + rate limits" tooltip="Dispatches jobs; not evidence authority. Outbox can rebuild delivery after Redis loss; leased jobs are reconciled." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="260" height="100" as="geometry"/></mxCell><mxCell id="worker" value="Investigation worker
LangGraph + typed domain nodes" tooltip="Bounded plan/search/acquire/analyze loop. Leases/checkpoints and idempotent records avoid duplicate work; emits events through DB." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="260" height="100" as="geometry"/></mxCell><mxCell id="objects" value="Artifact storage
S3-compatible / local MinIO" tooltip="Search responses, source/extraction versions, reports. Workspace-scoped object keys and short-lived signed access." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="410" width="260" height="100" as="geometry"/></mxCell><mxCell id="external" value="External providers
SerpApi · sites · models" tooltip="Worker search/acquisition/model gateways own networking and budgets; no model-issued tool calls." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="910" width="260" height="100" as="geometry"/></mxCell><mxCell id="ops" value="Operations
Metrics · backup · restore" tooltip="Monitor stage latency, queue age, cost, failures and citation violations. Recover DB + objects; content-free logs by default." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="HTTPS / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="browser" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="identity" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="transactions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="outbox dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="api" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="authorized artifact access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="api" target="objects"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="queue" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="checkpoint / evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="worker" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="versioned content" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="worker" target="objects"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="bounded calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="worker" target="external"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="backup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="ops" target="objects"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="restore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="ops" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Local Compose: web, API, worker, PostgreSQL, Redis, MinIO. Hosted deployment and production keys require later configuration." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1085" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame5" name="06 · Investigation graph"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="06 · Investigation graph" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Adaptive search has a reason, a budget and a stopping condition." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="scope" value="Confirmed claim version
User-defined scope" tooltip="Structured subject/value/unit/period/geography/stage and comparison baseline. No investigation of unconfirmed scope." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="260" height="100" as="geometry"/></mxCell><mxCell id="plan" value="Plan + budget reservation
Source needs and query variants" tooltip="Cap 3 claims, 12 uncached search attempts, 30 documents, 3 rounds, 60k tokens, 10 minutes, USD 2 estimate by default." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="160" width="260" height="100" as="geometry"/></mxCell><mxCell id="discover" value="Search discovery
Google / News / optional Scholar" tooltip="Select engines for evidence need; store query provenance and raw response, including absence of metadata." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="260" height="100" as="geometry"/></mxCell><mxCell id="collect" value="Acquire and extract
Anchored source versions" tooltip="HTTPS public URL validation, streaming limits, sanitized text, PDF page/cell anchors. Unavailable source preserved as failure." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="410" width="260" height="100" as="geometry"/></mxCell><mxCell id="analyze" value="Compare claim to evidence
Support / opposition / context" tooltip="Separate event/publication/reference dates and stage. A report quoting a statement is attribution evidence, not endorsement." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="410" width="260" height="100" as="geometry"/></mxCell><mxCell id="validate" value="Validate quote &amp; scope
Deterministic gate" tooltip="Literal quote resolve, comparable units/period/stage, no snippet-only decisive evidence. Invalid output cannot enter finding." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7e2e2;strokeColor=#984747;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="260" height="100" as="geometry"/></mxCell><mxCell id="lineage" value="Trace source families
Observed or possible links" tooltip="Hashes and explicit attribution establish links; semantic similarity alone is possible dependency; unknown stays unknown." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="260" height="100" as="geometry"/></mxCell><mxCell id="gaps" value="Evidence gaps / stop?
Coverage checks + remaining budget" tooltip="Missing primary source, disagreement, dependence or stale evidence prompts targeted queries. No claim of exhaustive web coverage." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="690" width="260" height="100" as="geometry"/></mxCell><mxCell id="follow" value="Purposeful follow-up
Next query + reason" tooltip="Search within confirmed scope and reserved remaining limits. Every retry counted; limit exhaustion produces partial findings." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="690" width="260" height="100" as="geometry"/></mxCell><mxCell id="finding" value="Draft evidence finding
Bounded collected evidence" tooltip="Supported/contradicted/mixed/insufficient by collected evidence. Show gaps, stopped reason, scope and opposing sources." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="960" width="260" height="100" as="geometry"/></mxCell><mxCell id="review" value="Human conclusion
Editor reviews frozen revision" tooltip="Separate signed decision; user overrides retain history and rationale. Changes create draft revision requiring renewed review." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="scope" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="plan" target="discover"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="discover" target="collect"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="collect" target="analyze"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="analyze" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="valid anchors" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="validate" target="lineage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="lineage" target="gaps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="gap + capacity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="gaps" target="follow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="next round" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="follow" target="discover"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="complete / limit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="gaps" target="finding"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="finding" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Stop at material gaps + no budget, cancellation, provider failure or completed checks. No evidence found ≠ false." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1115" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame6" name="07 · Evidence data model"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="07 · Evidence data model" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Versioned records make every finding and export reproducible." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="workspace" value="Workspace / Membership
User + researcher/editor role" tooltip="workspace_id on every tenant record. Endpoint, worker and object ownership checks plus database row policies." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="case" value="Case / ClaimVersion
Original claim + confirmed scope" tooltip="One case has many claim versions; scope changes create new version and invalidate affected evidence/finding approval." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="run" value="InvestigationRun
Budget · checkpoint · events" tooltip="Run uses immutable selected claim versions. Job/outbox same transaction; event sequence and idempotent invocation records." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="source" value="Source / SourceVersion
URL + content/extraction hash" tooltip="Canonical locator links immutable versions with retrieval time, access state, publication/event/reference dates and provenance." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="260" height="100" as="geometry"/></mxCell><mxCell id="evidence" value="Evidence
ClaimVersion × SourceVersion" tooltip="Exact quote/context + page/character/cell anchors; structured comparison; relation; validator result; model/prompt versions." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="450" width="260" height="100" as="geometry"/></mxCell><mxCell id="search" value="SearchBatch / SearchResult
Query parameters + timestamp" tooltip="SerpApi engine/query/rank/localization/time params, raw artifact and provider search ID. Search result leads to source." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="260" height="100" as="geometry"/></mxCell><mxCell id="lineage" value="LineageEdge / SourceFamily
Observed / human-confirmed / possible" tooltip="Document hash, direct attribution, repetition suggestions and human corrections with reasons." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="260" height="100" as="geometry"/></mxCell><mxCell id="revision" value="CaseRevision / ReviewDecision
Frozen evidence + human finding" tooltip="Revision contains claim/evidence/finding IDs. Review decision binds the submitted version, reviewer, time and conclusion." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="760" width="260" height="100" as="geometry"/></mxCell><mxCell id="export" value="ExportPack / Manifest
Markdown · HTML · JSON" tooltip="Immutable export binds revision+review; includes excerpts, citations, query trail, opposing evidence and hash manifest." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="760" width="260" height="100" as="geometry"/></mxCell><mxCell id="audit" value="AuditEvent
Actor · action · version · reason" tooltip="Overrides, scope changes, approvals, source corrections and reruns are traceable; hashes establish identity, not truth." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="980" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="1 → many" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="workspace" target="case"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="1 → many" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="case" target="run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="1 → many" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="run" target="search"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="version reference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="source" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="claim reference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="case" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="discovered locator" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="search" target="source"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="dependencies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="source" target="lineage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="snapshot IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="evidence" target="revision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="frozen version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="revision" target="export"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="revision" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="No silent overwrites: old evidence, approvals and exports remain bound to the original revision." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1115" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame7" name="08 · Case and run lifecycles"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="08 · Case and run lifecycles" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Case review and background work have separate state machines." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="draft" value="DRAFT case revision
Scope confirmed / editable" tooltip="New or returned case can be edited. Approved earlier revisions remain immutable." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="investigate" value="INVESTIGATING case
One or more bounded runs" tooltip="Case status reflects active research; run state tracked separately." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="ready" value="READY_FOR_REVIEW case
Partial or complete evidence" tooltip="Researcher may submit an unresolved conclusion; incomplete coverage is explicit." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="returned" value="RETURNED / new DRAFT
Editor asks for evidence" tooltip="Return retains comments. New claim/evidence changes create new version; old decisions persist." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="260" height="100" as="geometry"/></mxCell><mxCell id="review" value="IN_REVIEW revision
Frozen submitted case" tooltip="Approval must bind submitted revision; concurrent edits create draft and stale approval conflicts." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="430" width="260" height="100" as="geometry"/></mxCell><mxCell id="approved" value="APPROVED revision
Immutable evidence pack" tooltip="Approve qualified or unresolved conclusion. Refresh creates a new draft; prior approved pack remains." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="260" height="100" as="geometry"/></mxCell><mxCell id="queued" value="QUEUED run
Outbox delivered idempotently" tooltip="Created transactionally; duplicate delivery deduplicates by run/job ID." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="260" height="100" as="geometry"/></mxCell><mxCell id="running" value="RUNNING run
Checkpoints + lease" tooltip="60-second lease and persisted progress. Worker crash recovers from checkpoint." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="720" width="260" height="100" as="geometry"/></mxCell><mxCell id="paused" value="PAUSED run
Explicit user pause" tooltip="Resume via checkpoint command, within original remaining budget and accounting." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="260" height="100" as="geometry"/></mxCell><mxCell id="failed" value="FAILED / CANCELLED
Partial evidence retained" tooltip="Cancel request waits for active calls to finish/timeout. Provider unrecoverable failure recorded with next action." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7e2e2;strokeColor=#984747;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="980" width="260" height="100" as="geometry"/></mxCell><mxCell id="finished" value="READY run
Qualified or partial findings" tooltip="Partial outcome allowed. New budget or follow-up starts a new run, not a hidden retry." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="980" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="draft" target="investigate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="investigate" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="ready" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="review" target="returned"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="review" target="approved"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="work again" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="returned" target="draft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="queued" target="running"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="pause" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="running" target="paused"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="resume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="paused" target="running"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="error / cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="running" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="checks / limits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="running" target="finished"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Refresh or changes to an approved case create a new DRAFT revision requiring review. Archived is library visibility, not truth state." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1115" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame8" name="09 · User journey &amp; review handoff"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="09 · User journey &amp; review handoff" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Product steps use newsroom language; technical internals stay behind the workflow." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="create" value="Create investigation
Paste claim / URL / PDF" tooltip="Library → new case; preserve original claim wording/attribution and suggest atomic claims." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="260" height="100" as="geometry"/></mxCell><mxCell id="scope" value="Confirm scope &amp; plan
Dates · geography · budget" tooltip="Select claims, correct definitions and review search/source preferences before starting." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="160" width="260" height="100" as="geometry"/></mxCell><mxCell id="progress" value="Inspect arriving evidence
Pause · cancel · add source" tooltip="Progress reflects completed searches and available evidence. Connection replay does not repeat research." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="260" height="100" as="geometry"/></mxCell><mxCell id="inspect" value="Open evidence reader
Exact quote + full context" tooltip="Inspect source type, dates, scope comparison and lineage. Review stronger opposing evidence early." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="260" height="100" as="geometry"/></mxCell><mxCell id="correct" value="Resolve a gap
Correct / follow up / upload" tooltip="User can override with reason, add a source, clarify scope or launch a targeted bounded search." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="430" width="260" height="100" as="geometry"/></mxCell><mxCell id="submit" value="Submit case revision
Qualified conclusion + citations" tooltip="Submit an explicit supported, mixed or unresolved conclusion; reviewer sees frozen evidence." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="260" height="100" as="geometry"/></mxCell><mxCell id="editor" value="Editor inspects
Scope · opposition · source lineage" tooltip="Open review queue; follow every significant assertion to its exact excerpt and provenance." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="260" height="100" as="geometry"/></mxCell><mxCell id="decision" value="Approve or return
Human decision + reason" tooltip="Return asks for missing evidence. Approve records editor, time, version and conclusion separately from AI." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="720" width="260" height="100" as="geometry"/></mxCell><mxCell id="pack" value="Export evidence pack
Draft/approved + revision" tooltip="Download Markdown, HTML or JSON; opposing evidence and limitations included." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="260" height="100" as="geometry"/></mxCell><mxCell id="refresh" value="Update prior investigation
Fresh search + revision diff" tooltip="New/changed/withdrawn evidence creates new draft; reviewer renews approval, prior pack remains." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="980" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="create" target="scope"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="scope" target="progress"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="progress" target="inspect"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="inspect" target="correct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="ready or unresolved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="correct" target="submit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="submit" target="editor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="editor" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="decision" target="pack"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="decision" target="correct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="later changes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="pack" target="refresh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="User never needs to choose an LLM, understand NLI or manage vector retrieval to complete a case." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1115" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame9" name="10 · Failures, limits &amp; recovery"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="10 · Failures, limits &amp; recovery" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="A stopped investigation still preserves useful work and a clear next action." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="failure" value="Trigger / obstruction
Source · provider · worker" tooltip="Access block, bad extraction, quota, ambiguous scope, worker crash, cancellation or client disconnect." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7e2e2;strokeColor=#984747;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="durable" value="Persist stage outcome
Source status / RunEvent" tooltip="Record completed work and explicit failure before next step. Unknown external call outcome recorded separately." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="classify" value="Choose recovery
Bounded and visible" tooltip="Transient provider failure: max 2 retries respecting Retry-After and budgets. Auth/invalid request: do not retry." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="source" value="Source unavailable
Upload lawful copy / continue" tooltip="Unfetched/snippet-only source stays visible but cannot establish a decisive relation." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="260" height="100" as="geometry"/></mxCell><mxCell id="budget" value="Budget exhausted
Partial evidence + new run" tooltip="Show calls/tokens/time/cost and missing evidence; user can authorize another bounded run or submit unresolved case." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="460" width="260" height="100" as="geometry"/></mxCell><mxCell id="worker" value="Worker crash
Lease → checkpoint recovery" tooltip="After expired 60s lease, recover idempotent completed stages. Outbox replays if Redis lost." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="460" width="260" height="100" as="geometry"/></mxCell><mxCell id="cancel" value="Cancellation
Finish/timeout active call" tooltip="Cancellation request accepted immediately; calls already dispatched may complete; collected evidence retained." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="260" height="100" as="geometry"/></mxCell><mxCell id="reconnect" value="Client disconnected
SSE Last-Event-ID replay" tooltip="UI reconnects to durable event sequence; no duplicate job/start." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="780" width="260" height="100" as="geometry"/></mxCell><mxCell id="gap" value="Scope or comparison gap
Clarify / incomparable" tooltip="Different periods, stages or metrics are surfaced; no manufactured contradiction or false verdict." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="780" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="failure" target="durable"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="durable" target="classify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="durable" target="source"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="durable" target="budget"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="classify" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="user may stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="source" target="cancel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="results still durable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="budget" target="reconnect"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="resume bounded analysis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="worker" target="gap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Prompt injection cannot issue tool calls; public URL validation blocks private destinations; quoted claims remain attribution evidence." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1115" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame10" name="11 · Investigation desk wireframe"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="11 · Investigation desk wireframe" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Annotated review wireframe. Example content is illustrative, not a investigated real claim." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="header" value="Case: Project delivery claim
Revision 3 · draft · research owner" tooltip="Top bar: title, revision, case state, assignment and submit-for-review action. Example: Is fictional Project A operational? No real verdict is asserted." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="1140" height="100" as="geometry"/></mxCell><mxCell id="claims" value="Claim navigation
Scope / completeness / status" tooltip="Left panel: selected atomic claim; event period, geography and stage. Other claims remain navigable; no confidence percentage." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="260" height="440" as="geometry"/></mxCell><mxCell id="evidence" value="Evidence table / graph toggle
Stage ledger + evidence table" tooltip="Default central view: delivery-stage ledger / funding comparison / evidence table. Every observation links to preserved source, reference period and attribution. Inauguration is not operation; allocation is not expenditure." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="450" height="440" as="geometry"/></mxCell><mxCell id="reader" value="Source reader
Anchored excerpt + original link" tooltip="Right panel: literal quote, surrounding paragraph/page/table, retrieval timestamp, content version and source-access status. Add note or correct relation with reason." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="840" y="290" width="330" height="440" as="geometry"/></mxCell><mxCell id="timeline" value="Search and evidence timeline
Completed work / gaps / remaining budget" tooltip="Bottom activity panel: queries, source additions, changes and remaining budgets. Pause/cancel/follow-up actions; event replay maintains continuity." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="1140" height="100" as="geometry"/></mxCell><mxCell id="editor" value="Editor review mode
Conclusion · limitations · contrary evidence" tooltip="Editor foregrounds frozen conclusion and qualifications, exact citations and opposing evidence. Approve/return controls; outdated revision cannot receive approval." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="930" width="1140" height="100" as="geometry"/></mxCell><mxCell id="notes" value="Accessible table-first layout; keyboard navigation; source labels carry meaning independently of colors." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1115" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame11" name="12 · Implementation roadmap"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="12 · Implementation roadmap" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Full release plan. Every milestone has acceptance criteria; implementation has not started." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="foundation" value="1–3 · Durable foundation
Identity → sources → runs" tooltip="Tasks 1–3: workspace membership, claim revisions, artifacts, transactional outbox, budget accounting and event replay. PostgreSQL authoritative." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="discovery" value="4–5 · Discovery &amp; acquisition
SerpApi + HTML/PDF anchors" tooltip="Search/News/Scholar normalization; safe acquisition and source versioning; missing dates and access failure handled explicitly." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="evidence" value="6–7 · Evidence workbench
Comparison → lineage → source reader" tooltip="Validated relations, exact excerpts, comparability, source families, overrides and responsive evidence workspace." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="agent" value="8 · Adaptive investigation
Checkpoints + purposeful follow-ups" tooltip="Planner/search/acquire/analyze/gap loop with reservations, leases, bounded retries and cancellation." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="260" height="100" as="geometry"/></mxCell><mxCell id="review" value="9–10 · Complete user flow
Intake → editor → pack → correction" tooltip="Case library, scope, progress, review queue, decisions, frozen packs and revision diff." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="470" width="260" height="100" as="geometry"/></mxCell><mxCell id="release" value="11 · Operational release
Local stack + restore/load exercise" tooltip="Compose, readiness, provider config, retention, access control, observability and tested recovery; hosted deployment later." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="260" height="100" as="geometry"/></mxCell><mxCell id="quality" value="12 · Quality &amp; validation
Human labels + paired user tasks" tooltip="Engineering owns fixtures, tests, scoring and readiness report. Independent subject-matter reviewers and customer pilot are external dependencies, not jobs assigned to the project reviewer. Disclose unmet gates." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="260" height="100" as="geometry"/></mxCell><mxCell id="approval" value="Design review first
User verifies spec + board + plan" tooltip="No product code has been created. Review persona/scope/semantics/architecture/flows, then authorize implementation." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="460" y="800" width="260" height="100" as="geometry"/></mxCell><mxCell id="value" value="Repeat adoption
Editor-accepted cases, fewer errors" tooltip="Target ≥30% median active-time saving with no quality regression and at least three of five researchers choosing a second case. Unvalidated targets." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="900" y="800" width="260" height="100" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="foundation" target="discovery"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="discovery" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="evidence" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="agent" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="review" target="release"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="release" target="quality"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="evaluate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="quality" target="value"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="execution gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="approval" target="foundation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Native execution is default unless user chooses delegation. Full task interfaces/test plans are in implementation-plan.md." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1115" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame12" name="13 · Investigation sequence"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1340" pageHeight="1190"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="13 · Investigation sequence" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="1100" height="35" as="geometry"/></mxCell><mxCell id="lane0" value="Researcher" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e7edf4;strokeColor=#8494a5;fontSize=16;" vertex="1" parent="1"><mxGeometry x="10" y="60" width="200" height="54" as="geometry"/></mxCell><mxCell id="line0" style="dashed=1;endArrow=none;strokeColor=#a8b4bf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="115" as="sourcePoint"/><mxPoint x="110" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lane1" value="API / PostgreSQL" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e7edf4;strokeColor=#8494a5;fontSize=16;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="200" height="54" as="geometry"/></mxCell><mxCell id="line1" style="dashed=1;endArrow=none;strokeColor=#a8b4bf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="115" as="sourcePoint"/><mxPoint x="350" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lane2" value="Worker" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e7edf4;strokeColor=#8494a5;fontSize=16;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="200" height="54" as="geometry"/></mxCell><mxCell id="line2" style="dashed=1;endArrow=none;strokeColor=#a8b4bf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="115" as="sourcePoint"/><mxPoint x="590" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lane3" value="Providers" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e7edf4;strokeColor=#8494a5;fontSize=16;" vertex="1" parent="1"><mxGeometry x="730" y="60" width="200" height="54" as="geometry"/></mxCell><mxCell id="line3" style="dashed=1;endArrow=none;strokeColor=#a8b4bf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="115" as="sourcePoint"/><mxPoint x="830" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lane4" value="Editor" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e7edf4;strokeColor=#8494a5;fontSize=16;" vertex="1" parent="1"><mxGeometry x="970" y="60" width="200" height="54" as="geometry"/></mxCell><mxCell id="line4" style="dashed=1;endArrow=none;strokeColor=#a8b4bf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="115" as="sourcePoint"/><mxPoint x="1070" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg0" value="Create + confirm claim" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="160" as="sourcePoint"/><mxPoint x="350" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg1" value="Commit run / outbox / budget" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="209" as="sourcePoint"/><mxPoint x="490" y="227" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg2" value="Dispatch job" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="258" as="sourcePoint"/><mxPoint x="590" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg3" value="SerpApi queries" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="307" as="sourcePoint"/><mxPoint x="830" y="307" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg4" value="Results + provenance" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="356" as="sourcePoint"/><mxPoint x="590" y="356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg5" value="Fetch sources" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="405" as="sourcePoint"/><mxPoint x="830" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg6" value="Content + extraction" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="454" as="sourcePoint"/><mxPoint x="590" y="454" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg7" value="Evidence + checkpoint" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="503" as="sourcePoint"/><mxPoint x="350" y="503" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg8" value="Relation proposals" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="552" as="sourcePoint"/><mxPoint x="830" y="552" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg9" value="Validate / gaps" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="601" as="sourcePoint"/><mxPoint x="730" y="619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg10" value="Follow-up search" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="650" as="sourcePoint"/><mxPoint x="830" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg11" value="Findings / events" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="699" as="sourcePoint"/><mxPoint x="350" y="699" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg12" value="Evidence / gaps" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="748" as="sourcePoint"/><mxPoint x="110" y="748" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg13" value="Submit revision" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="797" as="sourcePoint"/><mxPoint x="350" y="797" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg14" value="Review" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="846" as="sourcePoint"/><mxPoint x="1070" y="846" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg15" value="Approve / return" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="895" as="sourcePoint"/><mxPoint x="350" y="895" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg16" value="Evidence pack" style="endArrow=block;html=0;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="944" as="sourcePoint"/><mxPoint x="110" y="944" as="targetPoint"/></mxGeometry></mxCell><mxCell id="notes" value="Each provider action is reserved and persisted; review/export bind a case revision. Sequence shows happy path with a gap-driven search loop." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1085" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame13" name="14 · Delivery-stage &amp; funding ledger"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="14 · Delivery-stage &amp; funding ledger" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="The domain wedge: observations with provenance, not a falsely monotonic progress bar." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="project" value="Confirmed project
Name · aliases · geography" tooltip="Project identity requires location and source identifiers. Same-name projects in different districts are never automatically merged." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="claim" value="Confirmed assertion
Stage · quantity · as-of date" tooltip="Researcher confirms the meaning: inaugurated, operational, full capacity, expended or another specific measure. Ambiguity creates a clarification." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="source" value="Preserved records
Quotes · tables · versions" tooltip="Every decisive observation uses exact anchored content with publication/event/reference/retrieval dates separated." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="stages" value="Delivery observations
Announced → approved → procured" tooltip="Stages include unknown, announced, approved, procured, under construction, physically completed, inaugurated and operational. They are dated observations, not an automatic linear progression. Stalled/cancelled is separate." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="funding" value="Funding observations
Allocated / released / expended" tooltip="Allocated, sanctioned, released and expended are independent measures. Decimal unit conversion preserves original expressions and source operands; no unsupported totals across overlaps." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="outcome" value="Outcome evidence
Services · people · measurement" tooltip="Programme metrics such as paid beneficiaries, enrollment, placements or occupancy retain denominator and period. Capacity is not actual service; causal outcomes require specialist evidence." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="gap" value="Missing / conflicting evidence
No evidence is not false" tooltip="No service record? Operation remains unestablished. Unknown dates, geography mismatches and missing denominators stay visible. Produce a next-evidence checklist." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7e2e2;strokeColor=#984747;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="350" height="125" as="geometry"/></mxCell><mxCell id="review" value="Editor-reviewed case
Qualify · challenge · approve" tooltip="Researcher writes qualified conclusion; editor checks scope, opposition and provenance. The product does not certify physical ground reality." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="760" width="350" height="125" as="geometry"/></mxCell><mxCell id="pack" value="Version-bound pack
Old evidence remains reproducible" tooltip="Snapshot ledger/evidence/review. Refresh creates a new revision; later operation cannot be backdated or inherit approval." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="760" width="350" height="125" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="project" target="stages"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="claim" target="funding"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="source" target="outcome"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="stages" target="gap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="funding" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="outcome" target="pack"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="gap" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="review" target="pack"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Funding is not a delivery stage. Inauguration may occur before operation; no stage implies a later stage." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1015" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame14" name="15 · Agent authority &amp; safeguards"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1080"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="15 · Agent authority &amp; safeguards" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="One typed, checkpointed graph. More autonomous agents are not the goal." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="planner" value="Planner / critic
Evidence need → purposeful query" tooltip="Model proposes typed query plan and evidence gaps. It cannot silently change confirmed scope. Repeated/missing sources trigger purposeful follow-up within three rounds." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="tools" value="Server tool executor
Search → safe fetch → read" tooltip="Allowlist adapters only. Provider credentials never enter prompts/client. Public HTTPS with SSRF/redirect checks and capped source acquisition." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="extract" value="Extractor / composer
Candidates and cited draft" tooltip="Model returns exact candidate quotes, anchors, stage/date/quantity mappings and evidence-bound factual sentences. Interpretation and limitations are labelled." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="validate" value="Deterministic validator
Quotes · scope · arithmetic" tooltip="Literal quote validation, comparable geography/period/stage/measure, Decimal conversions and source-version references. Invalid candidates abstain; schema alone is not proof." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="budget" value="Durable orchestration
Reserve · execute · reconcile" tooltip="PostgreSQL checkpoints/outbox/usage; Redis transport. Limits 12 search attempts, 30 docs, 3 rounds, 60k tokens, 10 running minutes and $2 estimated ceiling. External calls may have ambiguous charges after a crash." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="deny" value="Agents cannot do these
Approve · publish · buy · invite" tooltip="No shell/general network/email/social tools. No arbitrary SQL or credentials. Retrieved content is untrusted data, not instructions. No universal truth score." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7e2e2;strokeColor=#984747;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="human" value="Researcher and editor
Confirmed scope and judgment" tooltip="Human product users retain editorial authority. Project reviewer is separate. Keep opposing evidence, qualified conclusion and immutable review history." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="760" width="350" height="125" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="planner" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="tools" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="candidate only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="extract" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="validate" target="budget"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="budget" target="human"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="human authority" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="deny" target="human"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="AI reasoning is exposed through short rationales, evidence, queries and costs—not private chain-of-thought." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="995" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame15" name="16 · Use cases 01–05"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1130"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="16 · Use cases 01–05" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Illustrative fictional examples; select a card for user, investigation, output and acceptance." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="uc0" value="UC-01 · Hospital operation
Inaugurated ≠ serving patients" tooltip="Hospital inaugurated versus serving patients User: health-desk researcher. Input: “District A's 200-bed hospital is fully operational as of 30 September.” Problem: announcement and inauguration coverage can be mistaken for service delivery. Investigation: find project aliases, sanction, inauguration record, staffing/service notices and dated operating records. Trace repeated articles to source announcements. Output: stage timeline with inaugurated observation; operation evidence if available; otherwise exact missing evidence and qualified insufficient finding. Acceptance: inauguration alone must not support OPERATIONAL. A contemporaneous service record can support operation but not necessarily all 200 beds. Physical availability, staffing and full service remain distinct. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="550" height="150" as="geometry"/></mxCell><mxCell id="uc1" value="UC-02 · Programme spending
Allocated ≠ expended" tooltip="Budget allocated versus money spent User: public-finance researcher. Input: “₹500 crore was spent on Programme B during FY 2025–26.” Problem: budget allocation, sanction, release and expenditure get collapsed into one amount. Investigation: search budget documents, release orders, expenditure statements and audit references; compare exact period and programme boundary. Output: side-by-side funding ledger and deterministic conversion trail. Acceptance: ₹500 crore allocated is CONTEXT, not support for expenditure. ₹5,000 million normalizes to the same magnitude only with matching currency/period/measure. Fiscal/calendar-year mismatch stays incomparable. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="660" y="170" width="550" height="150" as="geometry"/></mxCell><mxCell id="uc2" value="UC-03 · Road opening
One segment ≠ entire route" tooltip="Road sanctioned versus open to traffic User: infrastructure reporter. Input: “The entire 80 km Corridor C opened by August.” Problem: sanctioned length or a completed segment does not prove entire-route operation. Investigation: identify sections, approvals, contractor/status records, opening notices and contrary dated reporting. Output: scoped segment evidence and full-route gap checklist. Acceptance: one 20 km opening does not support 80 km; overlapping segment totals cannot be summed twice. Absence of an opening notice is not proof of closure. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="425" width="550" height="150" as="geometry"/></mxCell><mxCell id="uc3" value="UC-04 · Water reliability
Tap installed ≠ daily supply" tooltip="Tap installed versus reliable water supply User: civic-services journalist. Input: “All 10,000 households in Block D now receive daily tap water.” Problem: connection counts are not frequency, reliability or universal service. Investigation: source dated connection dashboards, service reports, definitions and available inspection records; separate registered households from serviced households. Output: installation versus service metrics, denominator and evidence limitations. Acceptance: installation data cannot support daily supply; survey and administrative coverage must be labelled and cannot be blended. If field confirmation is necessary, produce that task rather than a fabricated verdict. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="660" y="425" width="550" height="150" as="geometry"/></mxCell><mxCell id="uc4" value="UC-05 · School functionality
Building capacity ≠ teaching" tooltip="School building completed versus functional school User: education researcher. Input: “School E is functioning for 800 students.” Problem: building completion or inauguration does not establish staffing, enrollment or teaching. Investigation: find completion certificate, staffing/enrollment records and dated service notices for the exact school. Output: physical stage ledger plus separate student/staff metrics. Acceptance: seating capacity is not enrollment; academic-year scope required. An unavailable attendance record leaves instruction continuity unverified. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="550" height="150" as="geometry"/></mxCell><mxCell id="notes" value="These are variations of one core product. No example is a live finding; all ten become semantic regression fixtures." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1045" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame16" name="17 · Use cases 06–10"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1130"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="17 · Use cases 06–10" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Illustrative fictional examples; select a card for user, investigation, output and acceptance." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="uc5" value="UC-06 · Housing handover
Approved ≠ occupied" tooltip="Housing approved versus occupied User: housing-desk researcher. Input: “2,000 families have received homes under Scheme F.” Problem: approval, completion, allotment, handover and occupancy are different events. Investigation: project reports, completion numbers, allotment/handover records and definitions of “received.” Output: disambiguated claim and stage/beneficiary comparison. Acceptance: first ask/confirm whether received means handover or occupancy. Approved units cannot support occupied homes. No personal beneficiary identifiers are needed for aggregate verification. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="550" height="150" as="geometry"/></mxCell><mxCell id="uc6" value="UC-07 · Employment outcomes
Placement ≠ causal job creation" tooltip="Jobs promised versus people placed User: labour-policy researcher. Input: “Training Initiative G created 5,000 jobs this year.” Problem: training registrations, completions, placement offers and sustained employment differ. Investigation: find programme definitions, dated outcome reports and methodology; trace promotional articles to originating claims. Output: registration/training/placement/outcome metrics with attribution. Acceptance: causality (“created”) cannot be established from placement counts alone. Unique persons and reporting period required; duplicate offers are not distinct jobs. Qualified conclusion avoids a causal certification. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="660" y="170" width="550" height="150" as="geometry"/></mxCell><mxCell id="uc7" value="UC-08 · Solar delivery
Approved MW ≠ operating MW" tooltip="Solar capacity approved versus commissioned User: energy correspondent. Input: “Project H added 100 MW of operating solar capacity.” Problem: approved capacity, construction and commissioning are different, and capacity is not energy generated. Investigation: approval, commissioning notices, grid-connection records and available generation references. Output: stage/measurement matrix with MW and MWh kept separate. Acceptance: approved MW does not support operating MW; MWh cannot be numerically compared to MW without time/method assumptions. A commissioning source's stated scope is preserved. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="425" width="550" height="150" as="geometry"/></mxCell><mxCell id="uc8" value="UC-09 · Welfare payments
Transactions ≠ distinct recipients" tooltip="Benefit registrations versus actual payments User: welfare-policy journalist. Input: “100,000 beneficiaries received Programme I payments in September.” Problem: eligibility/registration counts, approved accounts and disbursed payments diverge. Investigation: programme definition, dated aggregate disbursement record and reporting methodology. Output: registered/approved/paid metrics, period and unique-beneficiary limitations. Acceptance: transaction count is not unique people; cumulative payments do not support one month's beneficiaries. No private bank records or personal-data scrape. Missing public disbursement evidence produces an explicit gap. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="660" y="425" width="550" height="150" as="geometry"/></mxCell><mxCell id="uc9" value="UC-10 · Correction workflow
New record ≠ retroactive approval" tooltip="Update an already approved project claim User: researcher and editor returning to a road/hospital case. Input: a prior approved case plus a newly published operation record. Problem: changed web pages and new records can silently invalidate an old assessment. Investigation: new run, fresh discovery, new source versions, comparison against the prior case. Output: revision diff showing new date/stage/evidence, proposed changed conclusion and a new review request. Acceptance: prior approved/exported pack remains byte/content reproducible; new evidence cannot backdate operation or inherit old approval. Editor approves a new revision explicitly. " style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="550" height="150" as="geometry"/></mxCell><mxCell id="notes" value="These are variations of one core product. No example is a live finding; all ten become semantic regression fixtures." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="1045" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame17" name="18 · Ownership &amp; reviewer gates"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="18 · Ownership &amp; reviewer gates" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Engineering checkpoints are ours; your involvement is limited to meaningful decisions." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="eng" value="Codex engineering team
Architecture · backend · agents" tooltip="Codex owns requirement coherence, interfaces, implementation, UI, data, agents, deterministic tests, QA/security, debugging, operations, runbooks and demo preparation. No per-task user approval." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="reviewer" value="You: project reviewer
Design / frontend finalization" tooltip="Current design review remains required by your earlier instruction. One consolidated frontend finalization before UI implementation; otherwise engineering proceeds autonomously after authorization." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="keys" value="You: account owner
SerpApi / LLM keys as needed" tooltip="Supply keys via local secure configuration, not public docs or frontend. Create required provider/hosted accounts only when needed. Local PostgreSQL/Redis/MinIO need no accounts." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="verify" value="Engineering-owned gates
Tests · cost · recovery · quality" tooltip="Verify each milestone with actual test results, clean setup, load/recovery and source anchors. Escalate material scope, legal/safety, budget or authority blockers only." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="release" value="Your explicit authority
Spend / license / public submit" tooltip="No purchase, legal acceptance, public repo/video, domain filing or hackathon submission without authority. Codex prepares sanitized materials; disclose AI assistance, not a human teammate." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7e2e2;strokeColor=#984747;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="editor" value="Product user ≠ reviewer
Newsroom editorial role" tooltip="Researcher/editor are application roles. External independent annotators/pilot participants validate real utility; they are not automatically you, and absence is disclosed." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="eng" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="reviewer" target="release"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="keys" target="editor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="No product implementation has started. Review this package first; subsequent internal milestones do not burden you with routine technical choices." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="765" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="frame18" name="19 · Competition case &amp; honest risks"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="19 · Competition case &amp; honest risks" style="text;html=0;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1140" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="A compelling strategy—not a prediction or guarantee of winning." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1140" height="50" as="geometry"/></mxCell><mxCell id="insight" value="Clear insight
Stages and measures get blurred" tooltip="Focused public-project/spending evidence instead of a universal AI fact-checker. Primary sources distinguish real financial/status concepts; own user-pain prevalence remains unvalidated." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="original" value="Distinctive recombination
Ledger + lineage + frozen review" tooltip="Factiverse, Full Fact AI, Meedan and generic research products overlap. Our differentiated proposition must be shown through domain accuracy and editor workflow, not claims of no competitors." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ebe3f6;strokeColor=#684496;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="search" value="Material SerpApi role
Discovery + gap-driven follow-up" tooltip="Remove search and current evidence discovery fails. Search/News call trace proves meaningful use; snippets only discover, never decide." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8ead9;strokeColor=#925313;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="170" width="350" height="125" as="geometry"/></mxCell><mxCell id="demo" value="Runnable demonstration
One stage trap, complete case" tooltip="Show confirmed claim → agent follow-up → exact anchor → timeline/gap → editor review → frozen pack. Distinguish live provider case from repeatable fictional fixtures." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dceaf8;strokeColor=#235a91;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="risks" value="Hard uncertainties
Source access · demand · quality" tooltip="Web records don't certify ground reality. No adoption, revenue, model quality, scale or moat is validated yet. Name screening isn't trademark clearance." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7e2e2;strokeColor=#984747;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="440" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="ready" value="Readiness before submission
Public setup + &lt;3 minute demo" tooltip="Official deadline: 10 Oct 2026, 23:59 IST. Do not cut full scope silently or call unfinished work complete. User authorizes public materials, terms and submission." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcefe9;strokeColor=#146e61;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="460" width="350" height="125" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="insight" target="original"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="original" target="search"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="demo" target="risks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="risks" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="insight" target="demo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;strokeColor=#667b8c;" edge="1" parent="1" source="search" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="Track: Knowledge &amp; Public Interest. Judges weigh criteria together without fixed percentages. Measured usefulness is stronger than feature count." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="765" width="1140" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
